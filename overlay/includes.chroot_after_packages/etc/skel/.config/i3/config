# ============================================================
#  MARK 42 — i3 tiling window manager
#  Super key = $mod.  Press Super+F1 for the key cheat sheet.
# ============================================================
set $mod Mod4
font pango:Inter Medium 10
floating_modifier $mod
tiling_drag modifier titlebar

# ---- colors ----
set $red  #2f7fd6
set $hot  #64b4ff
set $dim  #1d3550
set $bg   #12161c
#                       border  backgr. text    indic.  child_border
client.focused          $hot    $red    #ffffff $hot    $red
client.focused_inactive $dim    #1a2230 #bbbbbb $dim    $dim
client.unfocused        #1a1a1a #0c0c0c #777777 #1a1a1a #1a1a1a
client.urgent           #ffffff $hot    #ffffff $hot    $hot
client.background       $bg

default_border pixel 2
default_floating_border pixel 2
gaps inner 8
gaps outer 2
smart_gaps on

# ---- autostart ----
exec --no-startup-id /usr/lib/x86_64-linux-gnu/libexec/polkit-kde-authentication-agent-1
exec --no-startup-id picom -b
exec --no-startup-id nm-applet
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock -n -c 0a0000
exec --no-startup-id mark42-conky
exec_always --no-startup-id feh --no-fehbg --bg-fill /usr/share/backgrounds/mark42/mark42-wallpaper.png

# ---- apps ----
bindsym $mod+Return exec konsole
bindsym $mod+d exec rofi -show drun
bindsym $mod+Tab exec rofi -show window
bindsym $mod+r exec rofi -show run
bindsym $mod+e exec dolphin
bindsym $mod+b exec firefox-esr
bindsym Print exec spectacle -r
bindsym $mod+Escape exec i3lock -c 0a0000
bindsym $mod+Shift+e exec mark42-power
bindsym $mod+F1 exec konsole --hold -e cat /usr/share/mark42/i3-keys.txt
bindsym $mod+Shift+q kill

# ---- media / hardware keys ----
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute        exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioPlay        exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext        exec --no-startup-id playerctl next
bindsym XF86AudioPrev        exec --no-startup-id playerctl previous
bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl set +10%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 10%-

# ---- focus / move (vim keys or arrows) ----
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# ---- layout ----
bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+t layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# ---- workspaces ----
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# ---- i3 itself ----
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

mode "resize" {
    bindsym j resize shrink width 10 px or 10 ppt
    bindsym k resize grow height 10 px or 10 ppt
    bindsym l resize shrink height 10 px or 10 ppt
    bindsym semicolon resize grow width 10 px or 10 ppt
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+Shift+s mode "resize"

# ---- window rules ----
for_window [class="(?i)conky"] floating enable, sticky enable, border none
for_window [class="(?i)pavucontrol|arandr|calamares|org.kde.polkit-kde-authentication-agent-1"] floating enable
for_window [window_role="pop-up|dialog"] floating enable

# ---- top bar ----
bar {
    position top
    status_command i3status
    tray_output primary
    font pango:Inter Medium 10
    separator_symbol "  "
    colors {
        background $bg
        statusline #ececec
        separator  $dim
        #                  border  backgr. text
        focused_workspace  $hot    $red    #ffffff
        active_workspace   $dim    #1a2230 #ffffff
        inactive_workspace $bg     $bg     #888888
        urgent_workspace   #ffffff $hot    #ffffff
        binding_mode       $hot    $red    #ffffff
    }
}
