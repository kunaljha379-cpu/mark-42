{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/mark42/fastfetch-logo.txt",
    "color": { "1": "blue", "2": "white" },
    "padding": { "right": 3 }
  },
  "display": { "color": { "keys": "blue", "title": "blue" }, "separator": "  ➜  " },
  "modules": [
    "title", "separator",
    { "type": "os", "key": "OS", "format": "MARK 42 (Debian {version-id} core)" },
    "kernel", "uptime", "packages", "shell", "de", "wm", "theme", "icons",
    "terminal", "cpu", "gpu", "memory", "disk", "localip", "break", "colors"
  ]
}
