#!/bin/sh
# MARK 42: run a program on the NVIDIA GPU (hybrid laptops).
# Example: prime-run flatpak run com.valvesoftware.Steam
if [ $# -eq 0 ]; then echo "usage: prime-run <program> [args]"; exit 1; fi
export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export __VK_LAYER_NV_optimus=NVIDIA_only
exec "$@"
