#!/bin/sh
# MARK 42 power menu (rofi)
c=$(printf '  Lock\n  Logout\n  Reboot\n  Shutdown\n' | rofi -dmenu -i -p "POWER" -lines 4 -width 20)
case "$c" in
  *Lock)     i3lock -c 0a0000 2>/dev/null || loginctl lock-session ;;
  *Logout)   if pgrep -x i3 >/dev/null; then i3-msg exit; else loginctl terminate-session "$XDG_SESSION_ID"; fi ;;
  *Reboot)   systemctl reboot ;;
  *Shutdown) systemctl poweroff ;;
esac
