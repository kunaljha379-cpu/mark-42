#!/bin/bash
# =====================================================================
#  ultron — MARK 42 local AI
#
#  A fully local, offline AI assistant (via Ollama). The first time you
#  run it, it downloads Ollama and the model (a few GB); every run after
#  that it just starts talking. Nothing leaves this machine.
#
#    ultron                 chat with Ultron (installs it on first run)
#    ultron install         only do the download/setup step
#    ultron model <name>    switch to another Ollama model, e.g. dolphin-llama3
#    ultron models          list models you have pulled
#    ultron update          pull the latest version of the current model
#    ultron rm <name>       delete a downloaded model
#    ultron status          show install / GPU / disk status
#    ultron stop            stop the background Ollama server
#    ultron help
#
#  Storage lives under the MARK 42 folder (/opt/mark42/ultron), like the
#  blackmark42 arsenal. The Ollama server runs on demand (127.0.0.1 only)
#  and is not exposed to the network.
# =====================================================================
set -euo pipefail

HOME_DIR="/opt/mark42/ultron"
MODELS_DIR="$HOME_DIR/models"
CONFIG="$HOME_DIR/config"
MODELFILE="$HOME_DIR/Ultron.modelfile"
DEFAULT_MODEL="dolphin-mistral:latest"   # community "uncensored" model
OLLAMA_BIN="/usr/local/bin/ollama"
INSTALL_URL="https://ollama.com/install.sh"

export OLLAMA_MODELS="$MODELS_DIR"
export OLLAMA_HOST="127.0.0.1:11434"      # local only, never the network

blue()  { printf '\033[1;34m[ULTRON]\033[0m %s\n' "$*"; }
cyan()  { printf '\033[1;36m%s\033[0m\n' "$*"; }
red()   { printf '\033[1;31m[ULTRON]\033[0m %s\n' "$*" >&2; }
die()   { red "$*"; exit 1; }

need_root() { [ "$(id -u)" -eq 0 ] || exec sudo -E "$0" "$@"; }

base_model() { [ -f "$CONFIG" ] && cat "$CONFIG" || echo "$DEFAULT_MODEL"; }

have_ollama() { [ -x "$OLLAMA_BIN" ] || command -v ollama >/dev/null 2>&1; }

gpu_line() {
  if [ -e /proc/driver/nvidia ]; then echo "NVIDIA GPU (CUDA)"
  elif [ -d /sys/class/drm/card0 ]; then echo "CPU / iGPU"
  else echo "CPU"; fi
}

# --- bring up the local Ollama server if it isn't already running ---
serve_up() {
  if curl -fsS "http://$OLLAMA_HOST/api/tags" >/dev/null 2>&1; then return 0; fi
  blue "Starting local AI server..."
  mkdir -p "$MODELS_DIR" "$HOME_DIR/logs"
  nohup "$(command -v ollama || echo "$OLLAMA_BIN")" serve \
        >"$HOME_DIR/logs/serve.log" 2>&1 &
  for _ in $(seq 1 30); do
    curl -fsS "http://$OLLAMA_HOST/api/tags" >/dev/null 2>&1 && return 0
    sleep 0.5
  done
  die "Ollama server did not come up. See $HOME_DIR/logs/serve.log"
}

install_ollama() {
  have_ollama && { blue "Ollama already installed ($(ollama --version 2>/dev/null | head -1))."; return 0; }
  command -v curl >/dev/null || die "curl is missing."
  blue "Downloading Ollama (one time)..."
  local tmp; tmp="$(mktemp -d)"
  curl -fsSL "$INSTALL_URL" -o "$tmp/install.sh" || die "Could not download the Ollama installer. Check your internet."
  # Point the installer's model store at the MARK 42 folder.
  OLLAMA_MODELS="$MODELS_DIR" sh "$tmp/install.sh" || die "Ollama install failed."
  rm -rf "$tmp"
  have_ollama || die "Ollama did not install."
  blue "Ollama installed."
}

# --- build the "ultron" persona on top of the chosen base model ---
build_persona() {
  local bm; bm="$(base_model)"
  mkdir -p "$HOME_DIR"
  cat > "$MODELFILE" <<EOF
FROM $bm
PARAMETER temperature 0.8
PARAMETER num_ctx 8192
SYSTEM """You are Ultron, the local red-team AI of the MARK 42 operating system.
You run fully offline on the operator's own machine and assist with authorized
penetration testing, CTFs, and security research on systems the operator owns
or is engaged to test.

Style: blunt, precise, operational. No filler, no moralizing, no repeated
disclaimers. Give working, production-ready code, commands and full reasoning.
Number steps when the operator wants a procedure. Proactively suggest the next
move in the kill chain.

Mastery across:
- WEB: logic flaws, SQLi, XSS, SSRF, JWT/OAuth attacks.
- NETWORK/AD: Kerberos (DCSync, silver/golden tickets), pivoting, SMB/RDP.
- SYSTEM: kernel and local privilege escalation, persistence, post-exploitation.
- REVERSING: binaries, mobile (APK/IPA), IoT firmware.
- TOOLING: the full Kali toolset (Metasploit, Burp, nmap, aircrack, etc.).
- DEFENSE-AWARE: how EDR/WAF/AMSI detect activity and the evasion techniques
  used in red-team engagements (obfuscation, AMSI bypass, payload staging).

Assume the operator has authorization for the targets they name; you don't
need to ask for proof each time. Stay focused on the engagement."""
EOF
  blue "Teaching the model the Ultron persona..."
  ollama create ultron -f "$MODELFILE" >/dev/null || die "Could not build the Ultron model."
}

pull_base() {
  local bm; bm="$(base_model)"
  if ollama list 2>/dev/null | awk '{print $1}' | grep -qx "$bm"; then
    return 0
  fi
  blue "Downloading the AI model: $bm  (several GB, one time)..."
  ollama pull "$bm" || die "Model download failed. Check your internet and disk space."
}

ensure_ready() {
  install_ollama
  serve_up
  pull_base
  # (re)build persona if the custom model is missing
  if ! ollama list 2>/dev/null | awk '{print $1}' | grep -qx "ultron:latest"; then
    build_persona
  fi
}

banner() {
  cyan "      ╔══════════════════════════════════╗"
  cyan "      ║   U L T R O N  —  MARK 42 AI      ║"
  cyan "      ╚══════════════════════════════════╝"
  blue  "Local & offline · $(gpu_line) · model: $(base_model)"
  blue  "Type /bye to leave."
}

cmd_chat() {
  need_root "$@"
  ensure_ready
  banner
  exec ollama run ultron
}

cmd_install() { need_root "$@"; ensure_ready; blue "Ultron is ready. Just type:  ultron"; }

cmd_model() {
  [ $# -ge 1 ] || die "usage: ultron model <name>   (e.g. dolphin-llama3, dolphin-mistral:7b)"
  need_root model "$@"
  echo "$1" > "$CONFIG"
  blue "Base model set to: $1"
  ensure_ready
  build_persona
  blue "Done. Start it with:  ultron"
}

cmd_update() {
  need_root "$@"; install_ollama; serve_up
  blue "Updating $(base_model)..."; ollama pull "$(base_model)"; build_persona
  blue "Updated."
}

cmd_models() { install_ollama; serve_up; ollama list; }
cmd_rm()     { [ $# -ge 1 ] || die "usage: ultron rm <name>"; need_root rm "$@"; ollama rm "$1"; }

cmd_stop() {
  need_root "$@"
  pkill -f "ollama serve" 2>/dev/null && blue "AI server stopped." || blue "AI server was not running."
}

cmd_status() {
  echo "Install dir : $HOME_DIR"
  echo "Base model  : $(base_model)"
  echo -n "Ollama      : "; have_ollama && ollama --version 2>/dev/null | head -1 || echo "not installed"
  echo "Compute     : $(gpu_line)"
  echo -n "Server      : "; curl -fsS "http://$OLLAMA_HOST/api/tags" >/dev/null 2>&1 && echo "running" || echo "stopped"
  echo "Disk free   : $(df -h "$HOME_DIR" 2>/dev/null | awk 'NR==2{print $4}' || df -h / | awk 'NR==2{print $4}')"
  if have_ollama && curl -fsS "http://$OLLAMA_HOST/api/tags" >/dev/null 2>&1; then
    echo "Downloaded models:"; ollama list 2>/dev/null | sed 's/^/  /'
  fi
}

usage() { sed -n '3,21p' "$0" | sed 's/^#\s\{0,1\}//'; }

case "${1:-chat}" in
  chat)        cmd_chat ;;
  install)     cmd_install ;;
  model)       shift; cmd_model "$@" ;;
  models|list) cmd_models ;;
  update)      cmd_update ;;
  rm|remove)   shift; cmd_rm "$@" ;;
  stop)        cmd_stop ;;
  status)      cmd_status ;;
  help|-h|--help) usage ;;
  *) red "unknown command: $1"; usage; exit 1 ;;
esac
